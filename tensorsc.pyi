from types import EllipsisType
from typing import Any, Iterator, Sequence, Union, overload

_Number = Union[bool, int, float]
_Nested = Union[_Number, Sequence["_Nested"]]
_IndexItem = Union[int, slice, None, EllipsisType]
_Index = Union[_IndexItem, tuple[_IndexItem, ...], "Tensor", list[int], list[bool], bool]
_Shape = Union[int, Sequence[int]]
# Anything operations accept as an input: tensors, numbers, nested lists.
_Operand = Union["Tensor", _Nested]
# A dtype, its name, a Python type (bool, int, float = bool, int64, float64)
# or a NumPy dtype.
_DTypeLike = Union["dtype", str, type, Any]

class dtype:
    @property
    def name(self) -> str: ...
    @property
    def itemsize(self) -> int:
        """Size of one element in bytes."""
    @property
    def is_floating_point(self) -> bool: ...
    def __eq__(self, other: object) -> bool:
        """Equal to the same dtype however it's spelled ("float32", np.float32, ...)."""
    def __hash__(self) -> int: ...

bool: dtype
uint8: dtype
int32: dtype
int64: dtype
float32: dtype
float64: dtype

class Tensor:
    def __init__(self, data: Union[_Nested, Tensor], dtype: _DTypeLike | None = None) -> None: ...

    # metadata
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def strides(self) -> tuple[int, ...]:
        """Strides in elements (not bytes)."""
    @property
    def ndim(self) -> int: ...
    @property
    def dtype(self) -> dtype: ...
    @property
    def device(self) -> str: ...
    def numel(self) -> int: ...
    def storage_offset(self) -> int:
        """Where this view starts in its storage, in elements."""
    def is_contiguous(self) -> bool: ...
    def is_floating_point(self) -> bool: ...
    def shares_memory(self, other: Tensor) -> bool:
        """True when both tensors read and write the same memory."""

    # copies and conversion
    def clone(self) -> Tensor: ...
    def copy(self) -> Tensor: ...
    def contiguous(self) -> Tensor:
        """This tensor if already contiguous, otherwise a contiguous copy."""
    def astype(self, dtype: _DTypeLike) -> Tensor:
        """A converted copy (always copies, like NumPy)."""
    def to(self, dtype: _DTypeLike) -> Tensor:
        """This tensor as `dtype` (shares memory if the dtype doesn't change, like PyTorch)."""

    # views (no data is copied unless noted)
    def view(self, *shape: _Shape) -> Tensor:
        """New shape (one dim may be -1). Raises if the layout doesn't allow a view."""
    def reshape(self, *shape: _Shape) -> Tensor:
        """New shape (one dim may be -1). A view when possible, otherwise a copy."""
    def flatten(self, start_dim: int = 0, end_dim: int = -1) -> Tensor: ...
    def permute(self, *dims: _Shape) -> Tensor: ...
    @overload
    def transpose(self) -> Tensor:
        """Reverse all axes."""
    @overload
    def transpose(self, dim0: int, dim1: int) -> Tensor:
        """Swap two axes."""
    @property
    def T(self) -> Tensor:
        """All axes reversed."""
    def squeeze(self, dim: int | None = None) -> Tensor: ...
    def unsqueeze(self, dim: int) -> Tensor: ...
    def expand(self, *shape: _Shape) -> Tensor:
        """A view stretched to `shape` (stride 0 on broadcast axes); -1 keeps a size."""
    def broadcast_to(self, shape: Sequence[int]) -> Tensor: ...

    # elements
    def item(self) -> _Number: ...
    def tolist(self) -> _Nested: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Union[Tensor, _Number]]: ...
    def __getitem__(self, key: _Index) -> Union[Tensor, _Number]:
        """A number when every axis gets an int; a view for ints, slices, None and ...;
        a copy for bool masks and arrays of positions."""
    def __setitem__(self, key: _Index, value: _Operand) -> None:
        """Writes through to this tensor, converting to its dtype and broadcasting."""
    def index_select(self, dim: int, index: _Operand) -> Tensor: ...
    def __bool__(self) -> bool: ...
    def __float__(self) -> float: ...
    def __int__(self) -> int: ...
    def __index__(self) -> int: ...

    # operators (broadcast; in-place forms write through views and keep the dtype)
    def __add__(self, other: _Operand) -> Tensor: ...
    def __radd__(self, other: _Operand) -> Tensor: ...
    def __sub__(self, other: _Operand) -> Tensor: ...
    def __rsub__(self, other: _Operand) -> Tensor: ...
    def __mul__(self, other: _Operand) -> Tensor: ...
    def __rmul__(self, other: _Operand) -> Tensor: ...
    def __truediv__(self, other: _Operand) -> Tensor: ...
    def __rtruediv__(self, other: _Operand) -> Tensor: ...
    def __floordiv__(self, other: _Operand) -> Tensor: ...
    def __rfloordiv__(self, other: _Operand) -> Tensor: ...
    def __mod__(self, other: _Operand) -> Tensor: ...
    def __rmod__(self, other: _Operand) -> Tensor: ...
    def __pow__(self, other: _Operand) -> Tensor: ...
    def __rpow__(self, other: _Operand) -> Tensor: ...
    def __and__(self, other: _Operand) -> Tensor: ...
    def __rand__(self, other: _Operand) -> Tensor: ...
    def __or__(self, other: _Operand) -> Tensor: ...
    def __ror__(self, other: _Operand) -> Tensor: ...
    def __xor__(self, other: _Operand) -> Tensor: ...
    def __rxor__(self, other: _Operand) -> Tensor: ...
    def __iadd__(self, other: _Operand) -> Tensor: ...
    def __isub__(self, other: _Operand) -> Tensor: ...
    def __imul__(self, other: _Operand) -> Tensor: ...
    def __itruediv__(self, other: _Operand) -> Tensor: ...
    def __ifloordiv__(self, other: _Operand) -> Tensor: ...
    def __imod__(self, other: _Operand) -> Tensor: ...
    def __ipow__(self, other: _Operand) -> Tensor: ...
    def __iand__(self, other: _Operand) -> Tensor: ...
    def __ior__(self, other: _Operand) -> Tensor: ...
    def __ixor__(self, other: _Operand) -> Tensor: ...
    def __eq__(self, other: _Operand) -> Tensor: ...  # type: ignore[override]
    def __ne__(self, other: _Operand) -> Tensor: ...  # type: ignore[override]
    def __lt__(self, other: _Operand) -> Tensor: ...
    def __le__(self, other: _Operand) -> Tensor: ...
    def __gt__(self, other: _Operand) -> Tensor: ...
    def __ge__(self, other: _Operand) -> Tensor: ...
    def __neg__(self) -> Tensor: ...
    def __pos__(self) -> Tensor: ...
    def __abs__(self) -> Tensor: ...
    def __invert__(self) -> Tensor: ...

    # named math
    def add(self, other: _Operand) -> Tensor: ...
    def sub(self, other: _Operand) -> Tensor: ...
    def mul(self, other: _Operand) -> Tensor: ...
    def div(self, other: _Operand) -> Tensor: ...
    def floor_divide(self, other: _Operand) -> Tensor: ...
    def remainder(self, other: _Operand) -> Tensor: ...
    def pow(self, exponent: _Operand) -> Tensor: ...
    def maximum(self, other: _Operand) -> Tensor:
        """Elementwise max; NaN wins."""
    def minimum(self, other: _Operand) -> Tensor:
        """Elementwise min; NaN wins."""
    def logical_and(self, other: _Operand) -> Tensor: ...
    def logical_or(self, other: _Operand) -> Tensor: ...
    def logical_xor(self, other: _Operand) -> Tensor: ...
    def logical_not(self) -> Tensor: ...
    def abs(self) -> Tensor: ...
    def neg(self) -> Tensor: ...
    def exp(self) -> Tensor: ...
    def log(self) -> Tensor: ...
    def sqrt(self) -> Tensor: ...
    def sin(self) -> Tensor: ...
    def cos(self) -> Tensor: ...
    def tanh(self) -> Tensor: ...
    def sigmoid(self) -> Tensor: ...
    def relu(self) -> Tensor: ...
    def floor(self) -> Tensor: ...
    def ceil(self) -> Tensor: ...
    def round(self) -> Tensor:
        """Rounds half to even."""
    def trunc(self) -> Tensor: ...
    def isnan(self) -> Tensor: ...
    def isinf(self) -> Tensor: ...
    def isfinite(self) -> Tensor: ...
    def clamp(self, min: _Operand | None = None, max: _Operand | None = None) -> Tensor: ...
    def allclose(self, other: _Operand, rtol: float = 1e-5, atol: float = 1e-8) -> bool: ...

# creation
def tensor(data: Union[_Nested, Tensor], dtype: _DTypeLike | None = None) -> Tensor:
    """A new tensor (a copy). Without dtype: bools stay bool, ints become int64, floats float32."""
def zeros(*shape: _Shape, dtype: _DTypeLike | None = None) -> Tensor: ...
def ones(*shape: _Shape, dtype: _DTypeLike | None = None) -> Tensor: ...
def full(shape: _Shape, fill_value: _Number, dtype: _DTypeLike | None = None) -> Tensor: ...
def arange(
    start: _Number, end: _Number | None = None, step: _Number | None = None,
    dtype: _DTypeLike | None = None,
) -> Tensor:
    """int64 if every argument is an int, else float32 (unless dtype is given)."""

# math functions (accept tensors, numbers or nested lists)
def abs(x: _Operand) -> Tensor: ...
def exp(x: _Operand) -> Tensor: ...
def log(x: _Operand) -> Tensor: ...
def sqrt(x: _Operand) -> Tensor: ...
def sin(x: _Operand) -> Tensor: ...
def cos(x: _Operand) -> Tensor: ...
def tanh(x: _Operand) -> Tensor: ...
def sigmoid(x: _Operand) -> Tensor: ...
def relu(x: _Operand) -> Tensor: ...
def floor(x: _Operand) -> Tensor: ...
def ceil(x: _Operand) -> Tensor: ...
def round(x: _Operand) -> Tensor: ...
def trunc(x: _Operand) -> Tensor: ...
def isnan(x: _Operand) -> Tensor: ...
def isinf(x: _Operand) -> Tensor: ...
def isfinite(x: _Operand) -> Tensor: ...
def logical_not(x: _Operand) -> Tensor: ...
def maximum(a: _Operand, b: _Operand) -> Tensor: ...
def minimum(a: _Operand, b: _Operand) -> Tensor: ...
def logical_and(a: _Operand, b: _Operand) -> Tensor: ...
def logical_or(a: _Operand, b: _Operand) -> Tensor: ...
def logical_xor(a: _Operand, b: _Operand) -> Tensor: ...
def where(cond: _Operand, a: _Operand, b: _Operand) -> Tensor:
    """`cond ? a : b` elementwise, broadcasting all three."""
def clamp(x: _Operand, min: _Operand | None = None, max: _Operand | None = None) -> Tensor: ...
def allclose(a: _Operand, b: _Operand, rtol: float = 1e-5, atol: float = 1e-8) -> bool: ...
def broadcast_to(x: _Operand, shape: Sequence[int]) -> Tensor: ...
def broadcast_shapes(*shapes: Sequence[int]) -> tuple[int, ...]: ...

# Set to False in release builds (`maturin develop --release`).
_debug_build: bool
