from types import EllipsisType
from typing import Iterator, Sequence, Union, overload

_Nested = Union[float, int, Sequence["_Nested"]]
_IndexItem = Union[int, slice, None, EllipsisType]
_Index = Union[_IndexItem, tuple[_IndexItem, ...]]
_Shape = Union[int, Sequence[int]]
# Anything arithmetic accepts on the other side: tensors, numbers, nested lists.
_Operand = Union["Tensor", _Nested]

class Tensor:
    def __init__(self, data: Union[_Nested, "Tensor"]) -> None: ...

    # metadata
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def strides(self) -> tuple[int, ...]:
        """Strides in elements (not bytes)."""
    @property
    def ndim(self) -> int: ...
    @property
    def dtype(self) -> str: ...
    @property
    def device(self) -> str: ...
    def numel(self) -> int: ...
    def storage_offset(self) -> int:
        """Where this view starts in its storage, in elements."""
    def is_contiguous(self) -> bool: ...
    def shares_memory(self, other: Tensor) -> bool:
        """True when both tensors read and write the same memory."""

    # copies
    def clone(self) -> Tensor: ...
    def copy(self) -> Tensor: ...
    def contiguous(self) -> Tensor:
        """This tensor if already contiguous, otherwise a contiguous copy."""

    # views (no data is copied unless noted)
    def view(self, *shape: _Shape) -> Tensor:
        """New shape (one dim may be -1). Raises if the layout doesn't allow a view."""
    def reshape(self, *shape: _Shape) -> Tensor:
        """New shape (one dim may be -1). A view when possible, otherwise a copy."""
    def flatten(self, start_dim: int = 0, end_dim: int = -1) -> Tensor: ...
    def permute(self, *dims: _Shape) -> Tensor: ...
    @overload
    def transpose(self) -> Tensor:
        """Reverse all axes."""
    @overload
    def transpose(self, dim0: int, dim1: int) -> Tensor:
        """Swap two axes."""
    @property
    def T(self) -> Tensor:
        """All axes reversed."""
    def squeeze(self, dim: int | None = None) -> Tensor: ...
    def unsqueeze(self, dim: int) -> Tensor: ...

    # elements
    def item(self) -> float: ...
    def tolist(self) -> _Nested: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Union[Tensor, float]]: ...
    def __getitem__(self, key: _Index) -> Union[Tensor, float]:
        """A float when every axis gets an integer, otherwise a view."""
    def __setitem__(self, key: _Index, value: Union[float, Tensor, _Nested]) -> None:
        """Writes through the indexed view."""
    def __float__(self) -> float: ...

    # broadcasting
    def expand(self, *shape: _Shape) -> Tensor:
        """A view stretched to `shape` (stride 0 on broadcast axes); -1 keeps a size."""
    def broadcast_to(self, shape: Sequence[int]) -> Tensor: ...

    # arithmetic (broadcasts; in-place forms write through views)
    def __add__(self, other: _Operand) -> Tensor: ...
    def __radd__(self, other: _Operand) -> Tensor: ...
    def __sub__(self, other: _Operand) -> Tensor: ...
    def __rsub__(self, other: _Operand) -> Tensor: ...
    def __mul__(self, other: _Operand) -> Tensor: ...
    def __rmul__(self, other: _Operand) -> Tensor: ...
    def __truediv__(self, other: _Operand) -> Tensor: ...
    def __rtruediv__(self, other: _Operand) -> Tensor: ...
    def __pow__(self, other: _Operand) -> Tensor: ...
    def __rpow__(self, other: _Operand) -> Tensor: ...
    def __iadd__(self, other: _Operand) -> Tensor: ...
    def __isub__(self, other: _Operand) -> Tensor: ...
    def __imul__(self, other: _Operand) -> Tensor: ...
    def __itruediv__(self, other: _Operand) -> Tensor: ...
    def __ipow__(self, other: _Operand) -> Tensor: ...
    def __neg__(self) -> Tensor: ...
    def __pos__(self) -> Tensor: ...
    def __abs__(self) -> Tensor: ...
    def add(self, other: _Operand) -> Tensor: ...
    def sub(self, other: _Operand) -> Tensor: ...
    def mul(self, other: _Operand) -> Tensor: ...
    def div(self, other: _Operand) -> Tensor: ...
    def pow(self, exponent: _Operand) -> Tensor: ...
    def maximum(self, other: _Operand) -> Tensor:
        """Elementwise max; NaN wins."""
    def minimum(self, other: _Operand) -> Tensor:
        """Elementwise min; NaN wins."""
    def abs(self) -> Tensor: ...
    def neg(self) -> Tensor: ...
    def exp(self) -> Tensor: ...
    def log(self) -> Tensor: ...
    def sqrt(self) -> Tensor: ...
    def sin(self) -> Tensor: ...
    def cos(self) -> Tensor: ...
    def tanh(self) -> Tensor: ...
    def sigmoid(self) -> Tensor: ...
    def relu(self) -> Tensor: ...
    def clamp(self, min: float | None = None, max: float | None = None) -> Tensor: ...
    def allclose(self, other: _Operand, rtol: float = 1e-5, atol: float = 1e-8) -> bool: ...

def tensor(data: Union[_Nested, Tensor]) -> Tensor: ...
def zeros(*shape: _Shape) -> Tensor: ...
def ones(*shape: _Shape) -> Tensor: ...
def full(shape: _Shape, fill_value: float) -> Tensor: ...
def arange(start: float, end: float | None = None, step: float = 1.0) -> Tensor: ...

# math functions (accept tensors, numbers or nested lists)
def abs(x: _Operand) -> Tensor: ...
def exp(x: _Operand) -> Tensor: ...
def log(x: _Operand) -> Tensor: ...
def sqrt(x: _Operand) -> Tensor: ...
def sin(x: _Operand) -> Tensor: ...
def cos(x: _Operand) -> Tensor: ...
def tanh(x: _Operand) -> Tensor: ...
def sigmoid(x: _Operand) -> Tensor: ...
def relu(x: _Operand) -> Tensor: ...
def maximum(a: _Operand, b: _Operand) -> Tensor: ...
def minimum(a: _Operand, b: _Operand) -> Tensor: ...
def clamp(x: _Operand, min: float | None = None, max: float | None = None) -> Tensor: ...
def allclose(a: _Operand, b: _Operand, rtol: float = 1e-5, atol: float = 1e-8) -> bool: ...
def broadcast_to(x: _Operand, shape: Sequence[int]) -> Tensor: ...
def broadcast_shapes(*shapes: Sequence[int]) -> tuple[int, ...]: ...

# Set to False in release builds (`maturin develop --release`).
_debug_build: bool
